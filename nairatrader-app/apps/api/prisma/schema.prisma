generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"  url = env("DATABASE_URL") }

// Money: BigInt kobo. Percent: basis points (3000 = 30%). Rules live in ChallengeProductVersion, never in code.

enum AccountStatus { UNKNOWN PENDING_PROVISION EVALUATION PASSED_AWAITING_UPGRADE FUNDED BREACHED CLOSED }
enum Phase { EVAL_1 EVAL_2 EVAL_3 FUNDED }
enum OrderStatus { PENDING_PAYMENT PAID FULFILLING PENDING_RECONCILE FULFILLED FAILED EXPIRED REFUNDED }
enum PaymentStatus { INITIATED SUCCEEDED FAILED AMOUNT_MISMATCH REFUNDED }
enum PayoutStatus { REQUESTED UNDER_REVIEW APPROVED PAID REJECTED FAILED }
enum ResetStatus { REQUESTED APPROVED PENDING_RECONCILE REJECTED COMPLETED }
enum TicketStatus { OPEN PENDING_USER PENDING_STAFF RESOLVED CLOSED }
enum BreachReason { MAX_DRAWDOWN DAILY_DRAWDOWN TIME_LIMIT RULE_VIOLATION MANUAL }
enum NotificationType { PHASE_PASSED DRAWDOWN_WARNING BREACH DEADLINE PAYOUT_UPDATE ORDER_UPDATE RESET_UPDATE TICKET_UPDATE }

model User {
  id            String   @id @default(uuid())
  externalId    String   @unique // id in existing identity system
  email         String?  @unique
  phone         String?  @unique
  displayName   String?
  createdAt     DateTime @default(now())
  devices       Device[]
  orders        Order[]
  accounts      TradingAccount[]
  payoutMethods PayoutMethod[]
  payouts       PayoutRequest[]
  resets        ResetRequest[]
  tickets       SupportTicket[]
  notifications Notification[]
  affiliate     AffiliateProfile?
}

model Device {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  pushToken String   @unique
  platform  String
  refreshHash String?
  lastSeenAt DateTime @default(now())
  @@index([userId])
}

model ChallengeProduct {
  id       String @id @default(uuid())
  slug     String @unique
  name     String
  active   Boolean @default(true)
  versions ChallengeProductVersion[]
}

model ChallengeProductVersion {
  id               String   @id @default(uuid())
  productId        String
  product          ChallengeProduct @relation(fields: [productId], references: [id])
  accountSizeKobo  BigInt
  priceKobo        BigInt
  phaseCount       Int
  phaseRules       Json     // [{phase, profitTargetBps, maxDrawdownBps, dailyDrawdownBps?, deadlineDays?}]
  fundedDrawdownBps Int
  profitShareBps   Int
  registrationRefundable Boolean @default(false)
  resetAllowed     Boolean @default(false)
  soldOut          Boolean @default(false)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  quotes           PriceQuote[]
  @@index([productId, effectiveFrom])
}

model PriceQuote {
  id        String   @id @default(uuid())
  userId    String
  versionId String
  version   ChallengeProductVersion @relation(fields: [versionId], references: [id])
  amountKobo BigInt
  expiresAt DateTime
  createdAt DateTime @default(now())
  order     Order?
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  quoteId   String      @unique
  quote     PriceQuote  @relation(fields: [quoteId], references: [id])
  status    OrderStatus @default(PENDING_PAYMENT)
  provisionTicketId String?
  idempotencyKey String  @unique
  affiliateRefCode String?
  createdAt DateTime    @default(now())
  payments  Payment[]
  account   TradingAccount?
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String
  providerRef String
  amountKobo  BigInt
  status      PaymentStatus @default(INITIATED)
  createdAt   DateTime      @default(now())
  @@unique([provider, providerRef])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  payload   Json
  processedAt DateTime?
  receivedAt DateTime @default(now())
  @@unique([provider, eventId])
}

model TradingAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  orderId       String?  @unique
  order         Order?   @relation(fields: [orderId], references: [id])
  mtLogin       String?  @unique
  credentialsEnc Bytes?   // AES-GCM ciphertext, shown once
  status        AccountStatus @default(PENDING_PROVISION)
  phase         Phase    @default(EVAL_1)
  phaseDeadline DateTime?
  balanceKobo   BigInt   @default(0)   // cached from gateway
  equityKobo    BigInt   @default(0)
  withdrawableKobo BigInt @default(0)
  lastSyncedAt  DateTime?  // our write time; UI staleness uses asOf below
  asOf          DateTime?  // gateway-reported data time (D13b)
  stateSource   String?
  contractVersion Int?
  createdAt     DateTime @default(now())
  ruleSnapshot  AccountRuleSnapshot?
  snapshots     EquitySnapshot[]
  breaches      BreachEvent[]
  payouts       PayoutRequest[]
  resets        ResetRequest[]
  @@index([userId, status])
}

model AccountRuleSnapshot {
  id         String @id @default(uuid())
  accountId  String @unique
  account    TradingAccount @relation(fields: [accountId], references: [id])
  versionId  String
  rules      Json   // frozen copy of ChallengeProductVersion at purchase
  createdAt  DateTime @default(now())
}

model EquitySnapshot {
  id         String   @id @default(uuid())
  accountId  String
  account    TradingAccount @relation(fields: [accountId], references: [id])
  balanceKobo BigInt
  equityKobo  BigInt
  takenAt    DateTime
  @@index([accountId, takenAt])
}

model BreachEvent {
  id        String   @id @default(uuid())
  accountId String
  account   TradingAccount @relation(fields: [accountId], references: [id])
  reason    BreachReason
  detail    String?
  occurredAt DateTime
}

model ResetRequest {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  accountId String
  account   TradingAccount @relation(fields: [accountId], references: [id])
  status    ResetStatus @default(REQUESTED)
  idempotencyKey String  @unique
  createdAt DateTime    @default(now())
}

model PayoutMethod {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  bankCode    String
  accountNumberEnc Bytes
  accountLast4 String
  accountName String
  verifiedAt  DateTime?
  payouts     PayoutRequest[]
}

model PayoutRequest {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  methodId    String
  method      PayoutMethod @relation(fields: [methodId], references: [id])
  amountKobo  BigInt
  status      PayoutStatus @default(REQUESTED)
  idempotencyKey String    @unique
  rejectionReason String?
  requestedAt DateTime     @default(now())
  paidAt      DateTime?
  bankReference String?
  @@index([accountId, status])
}

model RefundRecord {
  id        String @id @default(uuid())
  orderId   String
  amountKobo BigInt
  reason    String
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  accountId String?
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  messages  TicketMessage[]
}

model TicketMessage {
  id        String @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  fromStaff Boolean @default(false)
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  sentAt    DateTime?   // outbox: null until pushed
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model AffiliateProfile {   // v1.1
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  refCode  String @unique
  referrals Referral[]
}

model Referral {           // v1.1
  id          String @id @default(uuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id])
  orderId     String @unique
  commissionKobo BigInt @default(0)
  status      String @default("PENDING")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String   // user id or "system"
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}

model IdempotencyRecord {
  key         String   @id
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
}
